# Azure Foundry (required)
AZURE_FOUNDRY_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com
AZURE_FOUNDRY_API_KEY=your-azure-foundry-api-key
AZURE_FOUNDRY_MODEL=gpt-live-1
AZURE_FOUNDRY_TUTOR_MODEL=gpt-4o

# Optional: comma-separated extra model names
# AZURE_FOUNDRY_MODELS=

# Optional: override the tutor chat provider (defaults to Foundry values above)
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=

# Production deployment (VM only — copy to .env.production on the server)
# cp .env.example .env.production
# chmod 600 .env.production
